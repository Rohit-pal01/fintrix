# =====================================================================
# Database Configuration
# =====================================================================
# 1. Local Development (default SQLite):
DATABASE_URL=sqlite:///./finance_copilot.db

# 2. Neon Serverless PostgreSQL (For Live Deployment on Render/Neon):
# Paste your Neon connection string here:
# DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-XYZ.us-east-2.aws.neon.tech/neondb?sslmode=require
# READONLY_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-XYZ.us-east-2.aws.neon.tech/neondb?sslmode=require

# =====================================================================
# AI / LLM Provider Configuration
# =====================================================================
# Set to 'auto' to automatically detect whichever key you provide below:
LLM_PROVIDER=auto

# Option A: Google Gemini (Free / Fast)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: Groq (Ultra-fast Llama-3.3-70B, free tier)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option C: OpenAI (GPT-4o-mini / GPT-4o)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option D: Anthropic (Claude-3.5-Sonnet)
ANTHROPIC_API_KEY=

# Model Name Override (optional - defaults to best model for chosen provider)
# LLM_MODEL=gemini-1.5-flash
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=llama-3.3-70b-versatile

# =====================================================================
# Server & Deployment Configuration
# =====================================================================
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# Agent Execution Limits
MAX_STEPS=6
STATEMENT_TIMEOUT_SECONDS=5
MAX_RETRY_ATTEMPTS=2
